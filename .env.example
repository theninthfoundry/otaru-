# Database Tier (Prisma + PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/otaru?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/otaru?schema=public

# Redis Distributed Rate Limiter & Idempotency (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shopify Storefront & Admin API
SHOPIFY_STORE_DOMAIN=otaru.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_REVALIDATION_SECRET=

# Sanity CMS Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=otaru-studio
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Razorpay — Otaru Cryptographic Ledger & Payments
