# PostgreSQL Database (Neon Serverless / Supabase Free Tier)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# Distributed Redis Cache & Rate Limiting (Upstash Free Tier)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Administrative & Edge Security Secrets
ADMIN_API_SECRET=your_32_byte_hex_admin_secret
PAYMENT_CART_SECRET=your_32_byte_hex_cart_signing_secret
STRICT_PAYMENT_MODE=true

# Razorpay — Live Payment Gateway & Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_yourKeyId
RAZORPAY_KEY_ID=rzp_live_yourKeyId
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shopify Storefront & Admin API (Optional if using local catalog)
SHOPIFY_STORE_DOMAIN=otaru.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_REVALIDATION_SECRET=

# Sanity CMS Studio (Optional if using built-in mock/archival chapters)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics & Observability
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_META_PIXEL_ID=

# Shipping & Logistics (Shiprocket)
SHIPROCKET_API_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# CRM & Multi-Channel Messaging (Klaviyo & WhatsApp)
KLAVIYO_PRIVATE_KEY=
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
INTERAKT_API_KEY=

# App Core Configuration
NEXT_PUBLIC_SITE_URL=https://otaru.in
REVALIDATION_SECRET=
