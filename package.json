{
  "name": "otaru",
  "version": "0.1.0",
  "private": true,
  "description": "Otaru — Garments worth keeping. Editorial luxury garment archive.",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "production:verify": "vitest run src/__tests__/production-rehearsal.test.ts",
    "backend:check": "node scripts/verify-backend.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:build": "sanity build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "@portabletext/react": "^3.2.0",
