# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_REVALIDATION_SECRET=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Razorpay — Otaru Cryptographic Ledger Integration
# Leave empty to run in Interactive Escrow Sandbox mode (no real payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Security — HMAC-signed cart token secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — must be a 64-character hex string
PAYMENT_CART_SECRET=

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_META_PIXEL_ID=

# Shipping
SHIPROCKET_API_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATION_SECRET=
